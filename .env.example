# Secret used to sign session JWTs. Set a long random value in production.
AUTH_SECRET=change-me-in-production

# Database (MySQL/MariaDB) — run locally on port 3306.
# Create the database first: CREATE DATABASE audit_app_dev;
DB_HOST=localhost
DB_PORT=3306
DB_NAME=audit_app_dev
DB_USER=root
DB_PASSWORD=

# Optional: override the auto-seeded default accounts (first run only).
SEED_ADMIN_EMAIL=admin@s2i.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_STAFF_EMAIL=auditeur@s2i.local
SEED_STAFF_PASSWORD=Personnel123!
